\")\n","    for key, value in info.items():\n","        print(f\"{key} = {value}\")\n","\n","print_info(name=\"Alice\", age=25, city=\"Delhi\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1SprV2us29Uw","outputId":"cd9ea092-b87f-441d-a2a1-8c627648f471","executionInfo":{"status":"ok","timestamp":1784110548532,"user_tz":-330,"elapsed":42,"user":{"displayName":"PASARTHI SANJANA","userId":"13386261391473761518"}}},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["User Info:\n","name = Alice\n","age = 25\n","city = Delhi\n"]}]},{"cell_type":"code","source":["# 🔹 7. COMBINING *args AND **kwargs\n","\n","def show_details(*args, **kwargs):\n","    print(\"Args:\", args)\n","    print(\"Kwargs:\", kwargs)\n","\n","show_details(1, 2, 3, name=\"Ravi\", city=\"Mumbai\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aYCBVcVe2-5Q","outputId":"7315f415-12e3-48d2-e025-578e821fee9c","executionInfo":{"status":"ok","timestamp":1784110560174,"user_tz":-330,"elapsed":937,"user":{"displayName":"PASARTHI SANJANA","userId":"13386261391473761518"}}},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Args: (1, 2, 3)\n","Kwargs: {'name': 'Ravi', 'city': 'Mumbai'}\n"]}]},{"cell_type":"code","source":["# 🔹 8. FUNCTION NESTING (CALL ONE FUNCTION INSIDE ANOTHER)\n","\n","def multiply(a, b):\n","    return a * b\n","\n","def square(n):\n","    return multiply(n, n)\n","\n","print(\"Square of 4:\", square(4))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oIXw31eK3Alg","outputId":"92cd6cc1-d30f-40be-e6f9-e73f39a43cdd","executionInfo":{"status":"ok","timestamp":1784110569119,"user_tz":-330,"elapsed":55,"user":{"displayName":"PASARTHI SANJANA","userId":"13386261391473761518"}}},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Square of 4: 16\n"]}]},{"cell_type":"code","execution_count":18,"metadata":{"colab":{"base_uri":"https://localhost:80